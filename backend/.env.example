# Google OAuth — register at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Gemini API — get at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL connection string
# Local dev (Homebrew macOS): postgresql://YOUR_MACOS_USERNAME@localhost:5432/plannr
# Local dev (Linux / postgres role): postgresql://postgres@localhost:5432/plannr
# Production: postgresql://user:password@host:5432/plannr
DATABASE_URL=postgresql://your_username@localhost:5432/plannr

# Stripe — restricted key (rk_) from https://dashboard.stripe.com/apikeys with
# "Checkout Sessions: Read" permission (start in test mode)
STRIPE_SECRET_KEY=rk_test_your_key

# Stripe webhook signing secret from the endpoint you create at
# https://dashboard.stripe.com/webhooks pointing at /stripe/webhook
STRIPE_WEBHOOK_SECRET=whsec_your_secret

# Public TestFlight join link from App Store Connect, revealed after payment
TESTFLIGHT_LINK=https://testflight.apple.com/join/your_code
