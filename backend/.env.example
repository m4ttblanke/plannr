# Google OAuth — register at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Gemini API — get at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# PostgreSQL connection string
# Local dev (Homebrew macOS): postgresql://YOUR_MACOS_USERNAME@localhost:5432/plannr
# Local dev (Linux / postgres role): postgresql://postgres@localhost:5432/plannr
# Production: postgresql://user:password@host:5432/plannr
DATABASE_URL=postgresql://your_username@localhost:5432/plannr
