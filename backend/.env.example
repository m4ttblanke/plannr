# Google OAuth — register at https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

# Google Gemini API — get at https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# SQLite database path (relative to backend/database/)
# Defaults to SAMPLE.db if unset. Override in production.
DB_FILEPATH=plannr.db
